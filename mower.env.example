## Modify this file with your own values.
## "##" = explanation. A single "#" = an optional setting — uncomment to enable it.

## MQTT broker connection
MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=

## MQTT topic prefix used for all published/subscribed topics
MOWER_BASE_TOPIC=mower_ble

## How often (seconds) to poll the mower. 60 is a sensible default — don't go much lower.
MOWER_POLL=60

## How often (seconds) to re-check the weekly schedule. It's re-checked immediately
## after a SET_SCHEDULE/CLEAR_SCHEDULE command regardless of this setting; this interval
## just covers schedule changes made from the official Gardena app. 900 (15 min) is a
## sensible default — it doesn't need to be as frequent as MOWER_POLL.
MOWER_SCHEDULE_POLL=900

## Your mower's Bluetooth MAC address.
## Leave blank or set to AA:BB:CC:DD:EE:FF to enable BLE autodiscovery (detects the first nearby mower).
MOWER_ADDRESS=AA:BB:CC:DD:EE:FF

## The PIN configured on your mower (same PIN used in the official Gardena app).
## Note: For Bluetooth pairing/bonding, the PIN must be entered physically on the mower
## using its button keypad. The buttons map to digits as follows:
##   1 = Power button
##   2 = Calendar button
##   3 = Start button
##   4 = Home button
## Example: If your PIN is 1234, you would physically press:
##   Power (1) -> Calendar (2) -> Start (3) -> Home (4)
MOWER_PIN=1234

## Logging settings (LOG_LEVEL can be DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

## Enable persistent file logging (writes to ./logs/mower.log).
## Auto-rotated: 1MB active file + 10 gzipped backups (11 files total).
# LOG_FILE=logs/mower.log

## Auto-recovery escalation (native install: needs the polkit rule in INSTALL-NATIVE.md)
## Restart bluetooth.service after this many failed restarts in a row
BLUETOOTH_RESTART_THRESHOLD=3
## Min seconds between bluetooth.service restarts
BLUETOOTH_RESTART_COOLDOWN=900
## Allow rebooting the host as a last resort
# REBOOT_ESCALATION_ENABLED=false
## Reboot after this many failed bluetooth.service restarts
# REBOOT_AFTER_BT_ESCALATIONS=2
## Min seconds between reboots
# REBOOT_COOLDOWN=3600
